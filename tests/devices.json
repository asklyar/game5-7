  "test_matrix": {
    "description": "Test matrix for PM-18 requirements coverage",
    "requirements": [
      {
        "id": "AC1",
        "name": "All game elements fully visible in portrait viewport",
        "tests": ["test_ac1_basic_layout", "test_ac1_overflow_handling"]
      },
      {
        "id": "AC2",
        "name": "Two-column layout for landscape 320-430px height",
        "tests": ["test_ac2_landscape_two_column", "test_ac2_no_clipping"]
      },
      {
        "id": "AC3",
        "name": "Safe area positioning for ?safe=59,0,34,0 param",
        "tests": ["test_ac3_top_padding", "test_ac3_bottom_padding"]
      },
      {
        "id": "AC4",
        "name": "Single column with 5-year first in 320x568 viewport",
        "tests": ["test_ac4_menu_column_order", "test_ac4_min_font_size"]
      },
      {
        "id": "AC5",
        "name": "Catch popup fits within visible height with internal scroll",
        "tests": ["test_ac5_popup_fit", "test_ac5_close_reachable"]
      },
      {
        "id": "AC6",
        "name": "Lazy image loading prevents layout shift",
        "tests": ["test_ac6_lazy_loading", "test_ac6_no_layout_shift"]
      },
      {
        "id": "AC7",
        "name": "No zoom or text selection on quick double tap",
        "tests": ["test_ac7_no_zoom", "test_ac7_text_selection"]
      },
      {
        "id": "AC8",
        "name": "Home screen app with back button control",
        "tests": ["test_ac8_back_button_visible", "test_ac8_menu_control"]
      },
      {
        "id": "AC9",
        "name": "Existing test suite must still pass",
        "tests": ["test_pm_18_integration", "test_existing_suite_stable"]
      }
    ]
  },
  
  "acceptance_criteria_tests": {
    "test_ac1_basic_layout": {
      "description": "Verify all elements visible without overflow in portrait",
      "expected": {
        "element_overflow": false,
        "horizontal_scroll": false,
        "topbar_visible": true
      }
    },
    "test_ac2_landscape_two_column": {
      "description": "Game uses two-column layout when height 320-430px",
      "expected": {
        "game_container": "grid with 2 columns",
        "topbar_layout": "flex-wrap"
      }
    },
    "test_ac3_safe_areas": {
      "description": "Safe area values correctly parsed and applied",
      "input": "?safe=59,0,34,0",
      "expected": {
        "top_padding": 59,
        "bottom_padding": 34
      }
    }
  },
  
  "test_commands": {
    "run_all_pm18_tests": [
      "python3 tests/test_pm_18.py",
      "--coverage",
      "--safe=59,0,34,0"
    ],
    "simulate_ios_device": {
      "user_agent": "Mozilla/5.0 (iPhone; CPU iPhone OS 14_0 like Mac OS X)",
      "viewport": {width: 375, height: 667}
    }
  },
  
